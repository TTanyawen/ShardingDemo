    <groupId>com.example</groupId>
    <artifactId>ShardinngDemo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ShardinngDemo</name>
    <description>ShardinngDemo</description>

    <properties>
        <java.version>17</java.version>
